# Copy to  deploy/azure/.env.deploy  (gitignored) and fill in.
# deploy.sh sources this; secrets never touch the command line / shell history.
#
# ⚠️ Put REAL values ONLY in .env.deploy (gitignored) — never in this .example.

# ── The ONE thing you must create: a cloud-reachable MongoDB ──
# Atlas M0 (free): https://cloud.mongodb.com -> Build a Database -> M0 ->
# region "Mumbai (ap-south-1)" -> create a DB user -> Network Access: allow 0.0.0.0/0
# -> "Connect" -> "Drivers" -> copy the SRV string, add the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=yojnasetu

# ── Must match your local dev configs EXACTLY (so encrypted data round-trips
#    and FastAPI<->Spring auth matches). Copy from application-local.properties
#    (encryption.key, encryption.aadhaar-salt) and ai_service/.env (INTERNAL_API_KEY).
FIELD_ENCRYPTION_KEY=
AADHAAR_SALT=
INTERNAL_API_KEY=

# ── LLM / voice keys (from ai_service/.env) ──
GEMINI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# ── Azure knobs (defaults fine; set ACR after first run so redeploys reuse it) ──
RG=yojna-setu
LOCATION=centralindia
ENVNAME=yojna-env
# ACR=yojnasetuXXXXX
