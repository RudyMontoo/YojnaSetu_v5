# Spring gateway — local dev environment.
#
# STALE-FILE WARNING FIXED 2026-09-11: this file previously described a
# Postgres/Supabase + JWT_SECRET setup that no longer exists anywhere in this
# codebase (see application.properties) — following it produced a backend
# that could not boot. The variables below are the real ones read by
# application.properties, checked against source.
#
# Only FIELD_ENCRYPTION_KEY is required for the app to boot at all — every
# other variable below has a working default or degrades gracefully when
# unset (logged loudly, never silently). See the comment on each.

# ── MongoDB — required, but already has a working local default ──────────────
# Defaults to mongodb://localhost:27017 / db "yojnasetu", which is correct if
# you have Mongo running locally (Docker: `docker run -p 27017:27017 mongo:7`,
# or a native/Windows-service install). Uncomment only if yours differs —
# e.g. if you run the GATEWAY itself inside Docker while Mongo runs on the
# host machine, use host.docker.internal instead of localhost:
# MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=yojnasetu

# ── Field encryption — REQUIRED, the app refuses to start without this ────────
# AES-256-GCM key for every PII field at rest (name, phone, PAN, uploaded
# documents...). Must decode to exactly 32 bytes. The value below is a
# THROWAWAY key for local dev ONLY — it is committed here purely so a fresh
# clone boots immediately with zero setup steps. NEVER reuse it anywhere real
# (staging/prod/shared demo). Generate your own with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=Pss1q3ugZKGIGNcxafSkdnX3UWZFEUpW3JGwAqap8Bo=

# Salt mixed into the Aadhaar hash before storage. Any non-empty local-dev
# value works; production should use a real random one, not this one.
# Generate with: openssl rand -hex 16
AADHAAR_SALT=ca7103fce1f6b107d1811c454ed117df

# ── JWT (RS256) — optional in dev ──────────────────────────────────────────────
# If unset, an EPHEMERAL in-memory RSA keypair is generated on every boot
# (logged loudly) — fine for local dev (you'll just be logged out on every
# restart), never acceptable in production. Leave unset unless you need
# tokens to survive a restart. To generate real keys:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
# JWT_PRIVATE_KEY_PATH=./private.pem
# JWT_PUBLIC_KEY_PATH=./public.pem

# ── Frontend origin — required for cookies + CORS to work correctly ───────────
# Must exactly match the URL the frontend dev server is actually running at.
# Defaults already cover Vite's default port; only set this if your frontend
# is running somewhere else (a different port because 5173 was taken, a LAN
# IP, etc.) — a mismatch here is a common cause of "login succeeds but every
# request after it looks logged out" (CORS/cookie rejection).
FRONTEND_URL=http://localhost:5173

# ── ai_service (FastAPI) URL + shared internal-service secret ─────────────────
# Must be the SAME value as ai_service/.env's INTERNAL_API_KEY — the two
# services authenticate to each other with this shared secret. A mismatch
# fails closed (calls rejected), not open.
FASTAPI_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=dev-local-internal-key-change-me

# ── Everything below is fully optional — each feature it gates degrades to an
#    honest "not configured" state instead of crashing anything. ─────────────

# Email OTP (Brevo/any SMTP) + credential emails. Unset = logged to stderr
# instead of sent (fine for local dev — check the console for the OTP/code).
# MAIL_ENABLED=true
# MAIL_FROM=no-reply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Set true locally to echo OTPs/temp passwords to stderr when mail isn't
# configured — NEVER set this in production.
# APP_DEV_CREDENTIAL_ECHO=true

# Phone login via Firebase (Google sends the SMS). Unset = phone login
# returns a clear 503 "not available"; email OTP is unaffected.
# FIREBASE_CREDENTIALS_JSON=<firebase service-account JSON, or base64 of it>

# SMS OTP via Twilio (separate from Firebase phone login — used elsewhere).
# Unset = OTP is logged instead of sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# UIDAI offline eKYC signature verification. Unset = records are honestly
# stored with signatureVerified=false.
# UIDAI_CERT_PATH=

# DigiLocker / Account Aggregator — no live integration exists yet for any
# environment; leave unset. See docs/planning/SIH-CREDIT-API.md.
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=
# ACCOUNT_AGGREGATOR_API_KEY=
# ACCOUNT_AGGREGATOR_BASE_URL=
