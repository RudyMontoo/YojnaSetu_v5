# Rendered by nginx:alpine's envsubst entrypoint (${PORT}, ${AI_SERVICE_URL},
# ${SPRING_URL} are substituted at container start). Keeps the app single-origin:
# static SPA + reverse-proxy of the backend paths, so httpOnly cookies flow
# without CORS — the prod mirror of the dev vite proxy.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Azure Container Apps' internal ingress terminates TLS per-app and routes by
    # SNI. nginx does NOT send SNI on upstream TLS by default, so the handshake is
    # reset (502) — this makes it send SNI (= the upstream host). Server-level, so
    # it applies to every proxied location below.
    proxy_ssl_server_name on;

    # ── Trustworthy client IP (security: rate limiting + audit logs depend on it) ──
    # A client can send its own X-Forwarded-For, and Azure's ingress APPENDS the real
    # socket address rather than replacing the header. So the header arriving here is
    # [attacker-supplied junk..., real client] — the FIRST entry is forgeable and the
    # LAST is not. Anything keying on entry [0] can be evaded by rotating the header,
    # which uncaps every rate limit and lets audit_logs be poisoned.
    #
    # real_ip_recursive stays OFF (the default) deliberately: that makes nginx take
    # exactly the last XFF entry — the one Azure wrote — and stop. Trusting 0.0.0.0/0
    # is safe ONLY because of that: with recursion on it would walk left into the
    # attacker's entries. nginx is reachable only via ACA ingress, so $remote_addr is
    # always Envoy and the substitution always applies.
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Forwarded-For;
    # $remote_addr is now the real client. Backends read X-Real-IP, which we always
    # overwrite below, so a client-supplied X-Real-IP can never survive.

    # ACA's ingress (Envoy) rejects HTTP/1.0 with "426 Upgrade Required". nginx
    # proxies as HTTP/1.0 by DEFAULT, so every proxied location must force 1.1.
    # (The /ws block already set this; /api and /agents did not — hence the 426.)
    proxy_http_version 1.1;
    proxy_set_header Connection "";   # /ws overrides this with "upgrade"

    # Spring Boot gateway — all REST (auth, profile, applications, schemes, trending).
    location /api/ {
        proxy_pass ${SPRING_URL};
        proxy_set_header Host $proxy_host;        # ACA internal ingress routes by Host — must be the backend FQDN, not $host
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;   # unforgeable: overwrites any client value
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FastAPI ai_service — WebSockets (text chat + voice) need the upgrade headers.
    location /ws/ {
        proxy_pass ${AI_SERVICE_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;        # ACA internal ingress routes by Host — must be the backend FQDN, not $host
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;   # unforgeable: overwrites any client value
        proxy_read_timeout 3600s;   # long-lived voice/chat sockets
    }

    # FastAPI ai_service — the rest of the AI/agent REST surface.
    location ~ ^/(orchestrator|agents|ocr|voice|translate)/ {
        proxy_pass ${AI_SERVICE_URL};
        proxy_set_header Host $proxy_host;        # ACA internal ingress routes by Host — must be the backend FQDN, not $host
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;   # unforgeable: overwrites any client value
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;    # some agent calls (financial plan) are slow
    }

    # SPA fallback — every other path serves the app shell (client-side routing).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
